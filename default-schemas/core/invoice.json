      "label": "Amount"
    },
    "issued_on": {
      "type": "date",
      "label": "Issued"
    },
    "due_on": {
      "type": "date",
      "label": "Due"
    },
    "status": {
      "type": "enum",
      "label": "Status",
      "values": [
        "draft",
        "sent",
        "partial",
        "paid",
        "void",
        "overdue"
      ]
    },
    "payment_link": {
      "type": "url",
