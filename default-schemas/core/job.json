        "lead",
        "quoted",
        "scheduled",
        "in_progress",
        "completed",
        "invoiced",
        "paid",
        "cancelled",
        "on_hold"
      ]
    },
    "scheduled_at": {
      "type": "datetime",
      "label": "Scheduled"
    },
    "started_at": {
      "type": "datetime",
      "label": "Started"
    },
    "completed_at": {
      "type": "datetime",
      "label": "Completed"
    },
    "worked_dates": {
